#include "Lib/Common.bt"

struct DeadBeef
{
    int magic;      // -559038737
    int magic2;     // 454043394 - app
    Gap g(4);
    int hash;       // name hash ?
};

struct Header
{
    DeadBeef beef;
    int snoID;
    Gap g(4);
    int unk0;
    short unk1;
    short flags;
    short unk3;
    short unk4;
    float unk5;
    float unk6;
    int unks[100];
};

Header header<bgcolor=cLtGreen>;