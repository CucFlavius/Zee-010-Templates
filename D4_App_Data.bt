#include "Lib/Common.bt"

// ambient_camel.app

struct Header
{
    int snoID;
    int unk0;
    int unk1;
    int fileSize;
    Gap g(16);
};

typedef struct // Variable size, most often 44
{
    VECTOR3 position;
    VECTOR4SMALL normal;    // signed, n / 127.0
    VECTOR4SMALL tangent;   // signed, t / 127.0
    BGRA32 color0;
    BGRA32 color1;
    VECTOR2H UV0;            // half floats
    VECTOR2H UV1;            // half floats
    unsigned byte boneIndices[4];
    unsigned byte boneWeights[4];  
}VERTEX <bgcolor=cLtPurple>;

typedef struct {
    QUATERNION rotation;
    VECTOR3 position;
    VECTOR3 scale;
} BONETRANSFORM <optimize=true>;

struct BONE // 232
{
    OFFSET4 offsA;
    OFFSET4 offsB;
    int nameHash;
    int unk0;           // 0, 1, 2, 4
    short parentID;
    short unk1;         // -1, 0, 1, 3
    int unk2;           // 0, 65536, 131072, 327680
    int particleSnoID;
    BOUNDINGSPHERE bounds;
    BONETRANSFORM transforms[4];
    int unk3;

    // read data
    local long save = FTell();
    if (offsA.size > 0)
    {
        FSeek(offsA.offset);
        int unksA[offsA.size / 4]<bgcolor=cGreen>;
    }
    if (offsB.size > 0)
    {
        FSeek(offsB.offset);
        int unksB[offsB.size / 4]<bgcolor=cYellow>;
    }
    FSeek(save);
};

struct BONES(int count)
{
    BONE bones[count]<bgcolor=cRed,optimize=false>; 
};

