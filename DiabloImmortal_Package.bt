#include "Lib/Common.bt"

struct FILE
{
    uint strSize;
    if (strSize < 9999)
        STRINGc UUID(strSize);
    uint fileSize;
    char hash[32];
    byte fileData[fileSize];
    int unk;
    int sizeWhat;
    if (sizeWhat != 0)
    {
        byte what[sizeWhat];
    }
};

while(FTell() < FileSize())
{
    FILE file<optimize=false>;
}