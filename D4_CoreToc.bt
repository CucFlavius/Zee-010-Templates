#include "Lib/Common.bt"

void Align(int alignment)
{
    local int loc = FTell();
    local int pad = (alignment - (loc % alignment));
    if (pad != 0 && pad < alignment)
    {
        FSkip(pad);
    }
};

struct AssetInfo
{
    int UnkA;
    int fileID;
    int nameOffset;
};

struct AssetNames(int count)
{
    STRING name[count]<optimize=false, bgcolor=cYellow>;
};

struct AssetData(int index)
{
    local int id = index;
    AssetInfo info[assetCount[index]]<bgcolor=cLtRed>;
    AssetNames names(assetCount[index]);
    Align(4);
};

int snoGroupsCount;
local int snoGroupsCountOffs = 4;
local int offsetA = snoGroupsCountOffs + (snoGroupsCount * 4 + 4);
local int offsetB = snoGroupsCountOffs + 4 * snoGroupsCount + 4 * snoGroupsCount + 4;
local int countUnk = 4 * snoGroupsCount + 4 * snoGroupsCount + 4 * snoGroupsCount + 4;
local int offsetC = snoGroupsCountOffs + countUnk;

int pad;
int assetCount[snoGroupsCount]<bgcolor=cGreen>;

FSeek(offsetA);
uint assetUnk[snoGroupsCount]<bgcolor=cBlue>;

FSeek(offsetB);
uint assetCountC[snoGroupsCount]<bgcolor=cRed>;

FSeek(offsetC);

local int i;
for(i = 0; i < snoGroupsCount; i++)
{
    //if (assetCount[i] != 0)
        AssetData data(i);
}

